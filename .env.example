# Copy to .env.local for local dev. In Vercel, set these as Environment Variables.

# Supabase (server-side only — do NOT prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cookie signing secret. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-32-random-chars-or-more

# Resend (for bulk email sends from CLI)
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=Raw Smith Circle <circle@rawsmith.com>
REPLY_TO=hello@rawsmith.com

# Public site URL — used in the email "open your code" button.
# In Vercel, this should be the production deployment URL (e.g. https://your-app.vercel.app
# or your custom domain like https://claim.rawsmith.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
